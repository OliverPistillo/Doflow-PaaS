{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bootstrap-local",
  "description": "Bundled bootstrap UI with only Doflow-specific orchestration commands.",
  "windows": ["bootstrap"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:default",
    "allow-load-profile-registry",
    "allow-check-for-updates",
    "allow-get-bootstrap-update-state",
    "allow-prepare-profile-webview",
    "allow-activate-prepared-profile",
    "allow-remove-saved-profile",
    "allow-install-current-verified-update",
    "allow-quit-desktop",
    "allow-minimize-bootstrap"
  ]
}
