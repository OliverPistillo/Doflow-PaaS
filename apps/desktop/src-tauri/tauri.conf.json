{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doflow",
  "version": "1.0.0",
  "identifier": "it.doflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm local:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "bootstrap",
        "title": "Doflow",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#05070E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["bootstrap-local", "doflow-remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "publisher": "Doflow",
    "copyright": "Copyright Doflow",
    "category": "Business",
    "shortDescription": "Doflow cloud desktop client",
    "longDescription": "Secure cloud-first desktop client for Doflow.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": { "installMode": "passive" }
    }
  }
}
