{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && copyfiles -u 1 src/redis/scripts/*.lua dist",
    "start": "node dist/scripts/production-backend-entrypoint.js",
    "start:production": "node dist/scripts/production-backend-entrypoint.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d data-source.ts",
    "migration:prod:status": "node dist/scripts/run-production-migrations.js status",
    "migration:prod:run": "node dist/scripts/run-production-migrations.js run",
    "cutover:doflow:status": "node dist/scripts/doflow-production-cutover.js status --tenant=doflow",
    "cutover:doflow:dry-run": "node dist/scripts/doflow-production-cutover.js dry-run --tenant=doflow",
    "cutover:doflow:apply": "node dist/scripts/doflow-production-cutover.js apply",
    "cutover:doflow:verify": "node dist/scripts/doflow-production-cutover.js verify --tenant=doflow",
    "seed:doflow": "tsx src/scripts/seed-doflow-tenant.ts",
    "migrate:doflow": "tsx src/scripts/migrate-doflow-reference.ts",
    "delivery:legacy-map": "tsx src/scripts/map-doflow-delivery-legacy.ts --target=doflow",
    "commerce:legacy-map": "tsx src/scripts/map-doflow-commerce-legacy.ts --target=doflow",
    "automation-performance:legacy-map": "tsx src/scripts/map-doflow-automation-performance-legacy.ts --tenant=doflow"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.1.18",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/platform-socket.io": "11.1.18",
    "@nestjs/platform-ws": "11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/serve-static": "5.0.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "11.1.18",
    "@otplib/preset-default": "^12.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfkit": "^0.17.5",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.24",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.73.0",
    "bwip-js": "^4.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cron": "^4.4.0",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "imapflow": "^1.7.6",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "2.18.0",
    "mailparser": "^3.9.17",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "postcss": "^8.5.26",
    "postcss-js": "^5.1.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^22.2.1",
    "systeminformation": "^5.33.1",
    "typeorm": "^0.3.31",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.18",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cron": "^2.4.3",
    "@types/dotenv": "^8.2.3",
    "@types/express": "5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/systeminformation": "^3.54.1",
    "copyfiles": "^2.4.1",
    "jest": "^30.3.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  }
}
