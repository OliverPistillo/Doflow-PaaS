# ── Doflow Environment Variables ────────────────────────────
# Copy this file to .env and fill in real values before running docker-compose.
# All fields are REQUIRED in production — no defaults are provided
# to avoid silent misconfiguration.

# --- Postgres ---
POSTGRES_USER=doflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=doflow

# --- JWT ---
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-64-char-random-hex-string

# --- Public URLs ---
PUBLIC_API_URL=https://api.yourdomain.com/api
APP_BASE_URL=https://app.yourdomain.com

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback

# --- CORS whitelist (comma-separated) ---
CORS_ORIGINS=https://app.yourdomain.com
WEB_CSRF_COOKIE_DOMAIN=.yourdomain.com
CORS_PUBLIC_ORIGINS=https://doflow.it,https://www.doflow.it

# --- Public lead intake / reverse proxy ---
# api.doflow.it is expected to pass through Cloudflare Tunnel:
# visitor -> Cloudflare -> cloudflared -> Traefik/Coolify -> NestJS.
# CF-Connecting-IP is accepted only when the immediate peer is trusted by Express.
# X-Forwarded-For is not read directly by the public form endpoint.
# The visitor IP is used only as a SHA-256 rate-limit key and is never stored in the CRM.
TRUST_PROXY=loopback,linklocal,uniquelocal
PUBLIC_LEAD_INTAKE_TENANTS=doflow

# --- SMTP (optional; welcome/reset and Customer Inbox outbound) ---
MAIL_HOST=smtp.your-mail-host.example
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=mailbox@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_NAME=DoFlow
# Comma-separated tenant schemas allowed to use SMTP from Customer Inbox.
CUSTOMER_INBOX_MAIL_TENANTS=

# --- Customer Inbox IMAP inbound (optional) ---
# The backend starts normally when these values are absent.
CUSTOMER_INBOX_IMAP_TENANT_SCHEMA=
CUSTOMER_INBOX_IMAP_HOST=imap.your-mail-host.example
CUSTOMER_INBOX_IMAP_PORT=993
CUSTOMER_INBOX_IMAP_SECURE=true
CUSTOMER_INBOX_IMAP_USER=mailbox@yourdomain.com
CUSTOMER_INBOX_IMAP_PASSWORD=
CUSTOMER_INBOX_IMAP_MAILBOX=INBOX

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
